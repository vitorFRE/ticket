PORT=3001
NODE_ENV=development

# Database (local SQLite)
LOCAL_DATABASE_URL="file:dev.db"

# Database (production - Turso/libsql)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

FRONTEND_URL=http://localhost:3000
ALLOW_REGISTRATION=true

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# HMAC for ticket QR payloads
TICKET_HMAC_SECRET=dev-ticket-hmac-change-me

# Catalog APIs (organizador — proxy de busca)
# TMDb: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
# Ticketmaster Discovery: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=
