generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ORGANIZER
  CLIENT
  GATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum InventoryMode {
  SEAT_MAP
  GA_SECTOR
}

enum ExternalSource {
  TMDB
  TICKETMASTER
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  password     String?
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]
}

model Event {
  id              String         @id @default(uuid())
  organizerId     String
  title           String
  description     String?
  venue           String
  startsAt        DateTime
  priceCents      Int
  status          EventStatus    @default(DRAFT)
  inventoryMode   InventoryMode
  externalSource  ExternalSource
  externalId      String
  externalPayload Json?
  imageUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organizer       User           @relation(fields: [organizerId], references: [id])
  seats           Seat[]
  sectors         Sector[]

  @@index([status])
  @@index([organizerId])
}

model Seat {
  id      String     @id @default(uuid())
  eventId String
  label   String
  row     String
  number  Int
  status  SeatStatus @default(AVAILABLE)
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, label])
  @@index([eventId])
}

model Sector {
  id         String  @id @default(uuid())
  eventId    String
  name       String
  capacity   Int
  priceCents Int?
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
